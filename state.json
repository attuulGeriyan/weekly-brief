  {
   "note_id": "note_02_tiktok",
   "text": "We 1.6x'd TikTok budget from the week of Aug 15 to test whether it scales. Agreed with finance that we'd evaluate after 6 weeks and cut if TikTok CPA is more than 1.5x Meta's CPA over the test period.\n— Dan, Growth",
   "channels": [
    "tiktok"
   ],
   "date_from": "2026-08-15",
   "date_to": "2026-09-28",
   "kind": "experiment",
   "rule": "cut if cpa(tiktok)/cpa(meta) > 1.5 over the test period"
  },
  {
   "note_id": "note_03_brand",
   "text": "Brand awareness campaign went live on Meta the week of Sep 1. It's upper-funnel: expect spend to jump and last-click conversions to look worse for a while. Don't judge it on direct CPA.\n— Maya, Brand",
   "channels": [
    "meta"
   ],
   "date_from": "2026-09-01",
   "date_to": "2026-09-07",
   "kind": "campaign_change",
   "rule": "do not evaluate based on direct CPA"
  },
  {
   "note_id": "note_04_targets",
